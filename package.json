{
  "name": "recycling-blockchain-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["contracts", "backend", "frontend"],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "compile:contracts": "npm run compile -w contracts",
    "test:contracts": "npm run test -w contracts",
    "test:backend": "npm run test -w backend",
    "check:hedera": "npm run check:hedera -w contracts",
    "deploy:testnet": "npm run deploy:testnet -w contracts",
    "build": "npm run build -w backend && npm run build -w frontend"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}