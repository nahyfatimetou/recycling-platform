# Backend
PORT=4001
DATABASE_URL=postgresql://recycling_user:change_me_local_only@localhost:5433/recycling_db
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
FRONTEND_ORIGIN=http://localhost:5173

# Hedera Testnet (Chain ID 296)
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_CHAIN_ID=296
OPERATOR_ACCOUNT_ID=0.0.xxxxxxxx
OPERATOR_EVM_ADDRESS=0xYourOperatorEvmAddress
# ECDSA secp256k1 private key as 0x + 64 hex — never commit
BACKEND_OPERATOR_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY
REGISTRY_CONTRACT_ADDRESS=
TOKEN_CONTRACT_ADDRESS=
TX_CONFIRMATIONS=1
TX_WAIT_TIMEOUT_MS=120000
# Reconcile PROCESSING declarations on API boot (never submits a second mint)
RECONCILE_ON_STARTUP=true

# ECO reward policy (server-side only; amounts computed in integer wei)
# Default rates (ECO/kg): plastic 12, metal 15, aluminum 18, glass 8, paper 5,
# cardboard 4, organic 2, electronic 25, other 3
REWARD_RATES_JSON=
REWARD_MAX_ECO_PER_DECLARATION=1000
# Minimum quantity in millis of kg (100 = 0.1 kg)
REWARD_MIN_QUANTITY_MILLIS=100

# Gemini (server-side only — never expose in the frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
